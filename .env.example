# Server-only secrets. Never commit .env or expose these as VITE_* variables.
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
GEMINI_API_KEY=replace-with-server-only-gemini-key

# If the React frontend is hosted separately on Vercel, set its exact origin here.
# Example: https://your-project.vercel.app
FRONTEND_ORIGIN=https://your-project.vercel.app

# Frontend build-time API base. Leave empty when frontend and API share one origin.
# Example: https://your-api.example.com
VITE_API_URL=

# Optional runtime storage location. Note that serverless filesystems are not durable.
DATA_DIR=./data
